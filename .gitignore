# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors
.vscode/
.idea/

# Data roots — these are symlinks to large local storage, never commit them
/intermediate
/tcar_nuscenes

# Tool output. Everything here is regenerated by scripts/, so it is never
# committed; see README "Diagnostics and QA".
viz_cameras/
viz_lidar/
viz_projection/
clock_diag/

# Calibration snapshots ship only the numbers the pipeline reads (.txt/.npy).
# The verification renders and archives are large and reproducible.
calib/**/*.png
calib/**/*.tar.xz

# Bags and dataset artifacts
*.bag
*.pcd.bin
*.bin.zst
*.parquet

# Notebooks are committed without outputs (nbstripout-style); see CONTRIBUTING
.ipynb_checkpoints/
