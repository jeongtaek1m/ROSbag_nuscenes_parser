# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors
.vscode/
.idea/

# Data roots — these are symlinks to large local storage, never commit them
/intermediate
/tcar_nuscenes

# Tool output. Everything here is regenerated by scripts/, so it is never
# committed; see README "Diagnostics and QA".
viz_cameras/
viz_lidar/
viz_projection/
clock_diag/

# Calibration is deployment data, not code: intrinsics/extrinsics are specific to
# one vehicle build and the labelling vendor produces their own. Keep a snapshot
# locally and point --calib at it.
calib/

# Bags and dataset artifacts
*.bag
*.pcd.bin
*.bin.zst
*.parquet

# Notebooks are committed without outputs (nbstripout-style)
.ipynb_checkpoints/

# Agent instructions — local only
CLAUDE.md

# The perception stack's .msg definitions are no longer parsed by this pipeline.
# Only the two enums the label taxonomy is transcribed from are kept, so drift
# between msg/ObjectType.msg and common.OBJECT_TYPE_TO_CATEGORY stays checkable.
msg/*
!msg/ObjectType.msg
!msg/MotionType.msg
